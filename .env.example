# Database
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/minutesdb

# Ollama (local LLM)
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=gemma3:4b
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_CTX=1024

# App
APP_NAME=MinutesAPP
DEBUG=false
MAX_UPLOAD_BYTES=10485760

# Comma-separated origins for CORS (leave empty to disable)
# CORS_ORIGINS=https://your-domain.com
